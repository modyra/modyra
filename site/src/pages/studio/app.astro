---
// The Studio bundle is copied into public/studio-app before the site build.
// It remains a static asset because the documentation site has an isolated
// dependency installation and does not resolve workspace packages.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Modyra Studio</title>
    <meta name="description" content="Local-first visual form editor." />
    <link rel="stylesheet" href={`${base}/studio-app/studio.css`} />
  </head>
  <body style="margin:0">
    <div data-modyra-studio></div>
    <script type="module" src={`${base}/studio-app/studio.js`}></script>
  </body>
</html>
