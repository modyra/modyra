---
import SiteLayout from '../../components/SiteLayout.astro';

const based = (path: string) =>
  `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/${path.replace(/^\/+/, '')}`;
---

<SiteLayout
  title="Modyra Studio — visual form authoring"
  description="A local-first editor for authoring, validating, previewing and exporting Modyra form projects."
  eyebrow="Modyra Studio"
>
  <section class="hero">
    <h1>Author the model before choosing its final integration.</h1>
    <p>
      Studio is a local-first editor for Modyra projects. It works on the form
      model and contract, previews through <code>@modyra/plain</code>, and keeps
      generated targets separate from the authoring surface.
    </p>
    <div class="actions">
      <a class="primary" href={based('studio/app/')}>Launch Studio</a>
      <a href={based('studio/getting-started/')}>Studio documentation</a>
    </div>
  </section>

  <section class="flow" aria-labelledby="flow-heading">
    <h2 id="flow-heading">A model-first workflow</h2>
    <ol>
      <li><strong>Author</strong><span>Add fields, groups, arrays, layout and validation rules.</span></li>
      <li><strong>Inspect</strong><span>Review diagnostics against the project model and contract.</span></li>
      <li><strong>Preview</strong><span>Exercise supported fields with the framework-free renderer.</span></li>
      <li><strong>Export</strong><span>Generate project data, contract data or target-specific source files.</span></li>
    </ol>
  </section>

  <section class="boundaries" aria-labelledby="boundaries-heading">
    <h2 id="boundaries-heading">What Studio owns</h2>
    <div class="grid">
      <article>
        <h3>Project editing</h3>
        <p>Commands provide undo and redo while keeping IDs and derived paths consistent.</p>
      </article>
      <article>
        <h3>Contract diagnostics</h3>
        <p>Model and export diagnostics are shown before a project is handed to a renderer or target.</p>
      </article>
      <article>
        <h3>Local persistence</h3>
        <p>The current project is stored in the browser and can be exported or imported as JSON.</p>
      </article>
      <article>
        <h3>Target isolation</h3>
        <p>Generation runs outside the authoring state so a target failure does not mutate the project.</p>
      </article>
    </div>
  </section>

  <section class="status" aria-labelledby="status-heading">
    <h2 id="status-heading">Current scope</h2>
    <p>
      Studio is in active development. The project format, supported palette,
      preview coverage and generated targets may change before 1.0. Export
      project data regularly when using it for ongoing work.
    </p>
    <div class="actions">
      <a href={based('studio/building-blocks/')}>Available building blocks</a>
      <a href={based('studio/status/')}>Current capabilities</a>
    </div>
  </section>
</SiteLayout>

<style>
  .hero, .flow, .boundaries, .status { padding: 0 clamp(1.25rem, 7vw, 6rem) clamp(3.5rem, 7vw, 6rem); }
  .hero h1 { max-width: 18ch; font-size: clamp(2.5rem, 6vw, 4.7rem); line-height: 1.04; }
  .hero p, .status p { max-width: 62ch; color: var(--page-muted); font-size: 1.12rem; line-height: 1.6; }
  .actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.8rem; }
  .actions a { padding: .72rem 1rem; border: 1px solid var(--page-border); border-radius: .55rem; text-decoration: none; }
  .actions .primary { border-color: transparent; background: var(--mdy-gradient-brand); color: #fff; font-weight: 700; }
  .flow, .boundaries, .status { padding-top: clamp(2.5rem, 6vw, 4.5rem); border-top: 1px solid var(--page-border); }
  h2 { font-size: clamp(1.7rem, 3.5vw, 2.5rem); }
  ol { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; padding: 0; margin: 2rem 0 0; list-style: none; counter-reset: step; }
  li, article { padding: 1.25rem; border: 1px solid var(--page-border); border-radius: .7rem; background: var(--page-card); }
  li { display: grid; gap: .55rem; counter-increment: step; }
  li::before { content: counter(step, decimal-leading-zero); color: var(--page-accent); font-family: var(--page-mono); font-size: .8rem; }
  li span, article p { color: var(--page-muted); line-height: 1.55; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 2rem; }
  article h3 { font-size: 1.05rem; }
  @media (max-width: 50rem) { ol, .grid { grid-template-columns: 1fr; } }
</style>
