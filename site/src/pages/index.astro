---
import SiteLayout from '../components/SiteLayout.astro';

const based = (path: string) =>
  `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/${path.replace(/^\/+/, '')}`;
---

<SiteLayout
  title="Modyra — typed forms, independent of the UI"
  description="A typed form engine for TypeScript applications, with optional framework adapters and a framework-free renderer."
  eyebrow="Typed form engine for TypeScript"
>
  <section class="hero">
    <h1>Form behavior that does not belong to a framework.</h1>
    <p class="lede">
      Modyra keeps state, validation, lifecycle and form operations in a
      framework-independent engine. Render with <code>@modyra/plain</code>,
      connect an adapter, or use the engine without a UI.
    </p>
    <div class="actions">
      <a class="primary" href={based('start-here/')}>Read the documentation</a>
      <a href={based('studio/')}>Open Studio</a>
    </div>
  </section>

  <section class="principles" aria-labelledby="principles-heading">
    <div>
      <p class="section-label">Design</p>
      <h2 id="principles-heading">One model, explicit boundaries</h2>
    </div>
    <div class="principle-grid">
      <article>
        <h3>Behavior in the engine</h3>
        <p>Typed state, validation, arrays, drafts, history and submission are independent of the rendering layer.</p>
      </article>
      <article>
        <h3>Rendering is optional</h3>
        <p>Use the framework-free renderer, connect a framework adapter, or keep the form in a server, worker or test.</p>
      </article>
      <article>
        <h3>Limits stay visible</h3>
        <p>Adapters differ in UI coverage, SSR behavior and integration depth. Those differences are documented rather than hidden.</p>
      </article>
    </div>
  </section>

  <section class="try" aria-labelledby="try-heading">
    <div>
      <p class="section-label">Try the rendering boundary</p>
      <h2 id="try-heading"><code>@modyra/plain</code></h2>
      <p>
        The framework-free renderer is the shortest path from a validated
        field contract to interactive DOM. It is also the renderer used by
        Studio's live canvas.
      </p>
    </div>
    <pre><code>npm install @modyra/core @modyra/plain</code></pre>
    <div class="actions">
      <a class="primary" href={based('guides/usage-modes/')}>Choose a usage mode</a>
      <a href={based('studio/app/')}>Try it in Studio</a>
    </div>
  </section>

  <section class="paths" aria-labelledby="paths-heading">
    <p class="section-label">Continue</p>
    <h2 id="paths-heading">Start from the layer you need</h2>
    <div class="path-grid">
      <a href={based('guides/mental-model/')}>
        <strong>Understand the engine</strong>
        <span>State, handles, operations and lifecycle.</span>
      </a>
      <a href={based('guides/usage-modes/')}>
        <strong>Choose a rendering mode</strong>
        <span>Typed, headless, framework-free or data-driven.</span>
      </a>
      <a href={based('studio/')}>
        <strong>Explore Studio</strong>
        <span>Author, validate, preview and export a form model.</span>
      </a>
    </div>
  </section>
</SiteLayout>

<style>
  .hero, .principles, .try, .paths { padding: 0 clamp(1.25rem, 7vw, 6rem) clamp(3.5rem, 7vw, 6rem); }
  .hero { padding-top: 0; }
  .hero h1 { max-width: 14ch; font-size: clamp(2.7rem, 7vw, 5.4rem); line-height: 1.02; letter-spacing: -.025em; }
  .lede { max-width: 58ch; margin: 1.5rem 0 0; color: var(--page-muted); font-size: clamp(1.08rem, 1.8vw, 1.35rem); line-height: 1.55; }
  .actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; }
  .actions a { padding: .72rem 1rem; border: 1px solid var(--page-border); border-radius: .55rem; text-decoration: none; }
  .actions .primary { border-color: transparent; background: var(--mdy-gradient-brand); color: #fff; font-weight: 700; }
  .principles, .try, .paths { border-top: 1px solid var(--page-border); padding-top: clamp(2.5rem, 6vw, 4.5rem); }
  .section-label { margin: 0 0 .8rem; color: var(--page-muted); font-family: var(--page-mono); font-size: .78rem; letter-spacing: .1em; text-transform: uppercase; }
  h2 { max-width: 22ch; font-size: clamp(1.7rem, 3.5vw, 2.6rem); }
  .principle-grid, .path-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2rem; }
  article, .path-grid a { padding: 1.3rem; border: 1px solid var(--page-border); border-radius: .7rem; background: var(--page-card); }
  article h3 { font-size: 1.05rem; }
  article p, .try p, .path-grid span { color: var(--page-muted); line-height: 1.55; }
  .try { display: grid; grid-template-columns: 1.2fr .8fr; gap: 2rem; align-items: start; }
  .try .actions { grid-column: 1 / -1; margin-top: 0; }
  pre { margin: 0; overflow: auto; padding: 1.1rem; border: 1px solid var(--page-border); border-radius: .7rem; background: var(--page-card); }
  .path-grid a { display: grid; gap: .5rem; text-decoration: none; }
  .path-grid a:hover, .path-grid a:focus-visible { border-color: var(--mdy-indigo); }
  @media (max-width: 48rem) { .principle-grid, .path-grid, .try { grid-template-columns: 1fr; } }
</style>
