{
  "name": "@modyra/studio-target-angular",
  "version": "0.5.1",
  "private": true,
  "description": "Modyra Studio: the Angular MVP target scope (plan section 10) \u2014 generates a real @modyra/angular/adapter mdyForm() definition and implementation stubs from a Studio project.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "sideEffects": false,
  "dependencies": {
    "@modyra/studio-codegen": "workspace:*",
    "@modyra/studio-contract": "workspace:*",
    "@modyra/studio-model": "workspace:*"
  }
}
