{
    "name": "@modyra/styles",
    "version": "0.7.1",
    "description": "Framework-agnostic themes for modyra: the stylesheets, and the colour arithmetic that generates them.",
    "license": "MIT",
    "author": "Lorenzo Muscherà",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/modyra/modyra.git",
        "directory": "packages/styles"
    },
    "bugs": {
        "url": "https://github.com/modyra/modyra/issues"
    },
    "homepage": "https://github.com/modyra/modyra#readme",
    "keywords": [
        "css",
        "styles",
        "theme",
        "design-system",
        "framework-agnostic"
    ],
    "scripts": {
        "build": "node ../../scripts/tsc7.mjs packages/styles/tsconfig.json && node build.mjs",
        "test": "node --test test/*.test.mjs"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./default.css": {
            "default": "./dist/modyra-default.css"
        },
        "./modern.css": {
            "default": "./dist/modyra-modern.css"
        },
        "./material.css": {
            "default": "./dist/modyra-material.css"
        },
        "./ios.css": {
            "default": "./dist/modyra-ios.css"
        },
        "./ionic.css": {
            "default": "./dist/modyra-ionic.css"
        },
        "./base.css": {
            "default": "./dist/modyra-base.css"
        },
        "./foundation.css": {
            "default": "./dist/modyra-foundation.css"
        },
        "./salience.css": {
            "default": "./dist/modyra-salience.theme.css"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "publishConfig": {
        "access": "public"
    }
}
