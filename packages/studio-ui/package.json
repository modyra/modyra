{
  "name": "@modyra/studio-ui",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker-toolkit": {
      "types": "./dist/worker-toolkit.d.ts",
      "default": "./dist/worker-toolkit.js"
    },
    "./studio.css": {
      "default": "./dist/studio.css"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build-css.mjs",
    "test": "npm run build && node --import ./test/support/register.mjs --test test/*.test.mjs"
  },
  "dependencies": {
    "@modyra/plain": "workspace:*",
    "@modyra/studio-model": "workspace:*",
    "@modyra/studio-editor": "workspace:*",
    "@modyra/studio-contract": "workspace:*",
    "@modyra/studio-codegen": "workspace:*",
    "@modyra/studio-target-json": "workspace:*",
    "@modyra/studio-target-core": "workspace:*",
    "@modyra/studio-target-angular": "workspace:*",
    "@modyra/studio-target-react": "workspace:*",
    "@modyra/studio-preview": "workspace:*",
    "@modyra/styles": "workspace:*"
  },
  "sideEffects": [
    "*.css"
  ]
}
