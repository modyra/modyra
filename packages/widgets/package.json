{
  "name": "@modyra/widgets",
  "version": "2.1.0",
  "description": "Headless widget controllers and universal interaction/accessibility contract for Modyra.",
  "license": "MIT",
  "author": "Lorenzo Muscherà",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modyra/modyra.git",
    "directory": "packages/widgets"
  },
  "bugs": {
    "url": "https://github.com/modyra/modyra/issues"
  },
  "homepage": "https://github.com/modyra/modyra#readme",
  "keywords": [
    "widgets",
    "headless",
    "accessibility",
    "typescript",
    "framework-agnostic"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vocabulary": {
      "types": "./dist/vocabulary.d.ts",
      "default": "./dist/vocabulary.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.spec.mjs"
  },
  "sideEffects": false,
  "dependencies": {
    "@modyra/core": "^2.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "modyra-conformance": "./bin/modyra-conformance.mjs"
  }
}
