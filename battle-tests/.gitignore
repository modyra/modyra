# Failure artefacts are evidence of one run on one machine. A confirmed break is preserved by
# promoting it to regressions/, not by committing the raw report.
reports/failures/
reports/*.json
# The baseline is a decision, not a report: it records which battles are red because the defect they
# describe is open, so a build can fail on a regression and on nothing else. Ignoring it would make
# every known red look new on a fresh checkout.
!reports/known-red.json
!reports/known-red-browser.json
# Same reason: it records how many actions are taken without asserting their target exists, so the
# number cannot grow unnoticed. Ignored, a fresh checkout would have nothing to compare against and
# the check would refuse to run at all.
!reports/unguarded-actions.json

# Packed tarballs and the temporary consumers installed from them.
hostile-consumers/**/node_modules/
hostile-consumers/**/*.tgz
.tmp-consumer/

# The browser host page, rebuilt by battle:browser.
.tmp-browser/
test-results/
